# Backend environment. NAMES ONLY: never put a real value in this tracked file. Copy to .env (git-ignored) locally;
# in production set these in the backend host's environment settings (docs/DEPLOY.md, checkpoint 6b).
# Secrets are never stored in the DB in plain text, returned by the API, sent to the browser or logged.

# --- environment and auth
# ENV: development | test | preview | production. Unset or unknown = production (fail closed).
ENV=
# "1" = local fake user, ONLY with ENV=development or test (make dev sets both). Refused anywhere else.
DEV_AUTH=
# dev mode only: the local user (default owner@localhost = owner of migrated single-user data)
DEV_USER_EMAIL=
# comma-separated admin emails (always allowed; can invite people)
ADMIN_EMAILS=
# Supabase project URL, e.g. https://<project-ref>.supabase.co (tokens are verified with its public JWKS)
SUPABASE_URL=
# only if the project still signs tokens with the legacy HS256 secret
SUPABASE_JWT_SECRET=
# optional, server-side only: lets the admin page send invitation emails / delete auth users
SUPABASE_SERVICE_ROLE_KEY=
# ENV=preview only: the preview Supabase project ref(s), comma-separated. A preview refuses to start when
# SUPABASE_URL, DATABASE_URL or the service key belong to any other project (e.g. production).
PREVIEW_ALLOWED_SUPABASE_REFS=

# --- database
# Selects the database. Empty/unset = a SQLite file under DATA_DIR, allowed ONLY with ENV=development|test; any other
# ENV refuses to start (and `alembic upgrade head` fails). Deployed: the Supabase SESSION POOLER, as the app role:
#   postgresql+psycopg://investments_app.<project-ref>:<url-encoded password>@<pooler host>:5432/postgres
# (postgres:// and postgresql:// are accepted and mean the same; surrounding quotes/spaces are ignored)
DATABASE_URL=
DATA_DIR=

# --- AI (optional; server-side only)
ANTHROPIC_API_KEY=
# default model id when Settings has none (default claude-opus-5-5)
CLAUDE_MODEL=
# Fernet key for users' own AI keys (optional feature). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- jobs and data
SCHEDULER_ENABLED=
REFRESH_HOUR=
REFRESH_MINUTE=
STARTUP_REFRESH_MAX_AGE_HOURS=
SOURCE_TIMEOUT_SECONDS=
SOURCE_TIMEOUTS=

# --- internet-facing (deployed backend)
# exact frontend origins, comma-separated (production: the Vercel production URL / your domain)
CORS_ORIGINS=
# preview backend only: regex for Vercel preview URLs
CORS_ORIGIN_REGEX=
MAX_REQUEST_BYTES=
RATE_LIMITS_ENABLED=
# set by the host (Render sets PORT)
PORT=

# --- logging
LOG_LEVEL=
LOG_FORMAT=
# optional error monitoring (scrubbed exceptions only)
SENTRY_DSN=
LOG_DIR=

# --- local frontend dev only: where Next.js proxies /api
BACKEND_URL=

# Copy to .env and adjust. The app works with no secrets at all; the optional features below need them.
# .env is git-ignored. Secrets are never stored in the DB, shown in the UI, or logged.
# SQLite file under data/ (git-ignored). For Postgres later:
#   DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/investments
# Defaults (when unset): DATA_DIR=<repo>/data, DATABASE_URL=sqlite:///<repo>/data/investments.db
# DATABASE_URL=
# DATA_DIR=
# Daily market-data refresh (Asia/Kolkata). AMFI publishes NAVs by ~23:00 IST.
REFRESH_HOUR=23
REFRESH_MINUTE=30
SCHEDULER_ENABLED=true
# Refresh on backend start-up if the newest quote is older than this many hours (0 = never)
STARTUP_REFRESH_MAX_AGE_HOURS=18
# Frontend -> backend (used by Next.js rewrites)
BACKEND_URL=http://127.0.0.1:8000

# --- Optional: AI scenario analysis (Anthropic) ---
# Also requires turning ON "Allow outbound LLM calls" in Settings (off by default).
# ANTHROPIC_API_KEY=
# Default model (Settings › AI analysis can override):
# CLAUDE_MODEL=claude-opus-5-5

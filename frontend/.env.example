# Frontend environment (Vercel project settings in production). NAMES ONLY. Everything NEXT_PUBLIC_* is inlined into
# the browser bundle at build time, so it must never be a secret.
# "1" only for local development (no sign-in). Anything else, including unset: sign-in required. Never set on Vercel.
NEXT_PUBLIC_DEV_AUTH=
# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Vercel PREVIEW scope only: the preview Supabase project ref(s), comma-separated. In a preview (Vercel sets
# NEXT_PUBLIC_VERCEL_ENV) sign-in is disabled unless NEXT_PUBLIC_SUPABASE_URL is one of these projects.
NEXT_PUBLIC_PREVIEW_SUPABASE_REFS=
# Supabase "publishable"/anon key: public by design (protected by RLS and the backend's own checks)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# backend origin, e.g. https://api.example.com (empty in local dev: /api is proxied to BACKEND_URL)
NEXT_PUBLIC_API_URL=
# days the database provider keeps backups (shown on the Terms page; match your Supabase plan)
NEXT_PUBLIC_BACKUP_RETENTION_DAYS=
# local dev only: backend for the /api proxy
BACKEND_URL=

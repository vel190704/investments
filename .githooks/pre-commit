#!/usr/bin/env bash
# Pre-commit: refuse secrets, then run the full check. Installed by `make setup` (make hooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 1) secrets and data files in staged changes
.githooks/scan.sh

# 2) full check: tests, lint, typecheck (any failure blocks the commit)
make check

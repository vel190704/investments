#!/usr/bin/env bash
# Pre-commit: refuse secrets, then run the full check. Installed by `make setup` (make hooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 1) secrets in staged changes (added lines only)
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -v '^+++' \
   | grep -En 'sk-ant-[A-Za-z0-9_-]{10,}|ANTHROPIC_API_KEY=[A-Za-z0-9_-]{20,}' >/dev/null; then
  echo "pre-commit: refusing to commit — a secret (Anthropic API key) appears in the staged changes." >&2
  echo "Keep keys in .env (git-ignored), never in tracked files." >&2
  exit 1
fi
for f in $(git diff --cached --name-only); do
  base="${f##*/}"  # any directory: .env, .env.local, frontend/.env.production, ...
  case "$base" in
    .env|.env.*) [ "$base" = ".env.example" ] || { echo "pre-commit: refusing to commit $f" >&2; exit 1; } ;;
  esac
done

# 2) full check: tests, lint, typecheck (any failure blocks the commit)
make check
